            </figcaption>
          </figure>

          <!-- PICTURE 6 -->

          <figure class="photo">
            <img
              src="images/06-nazarbayev-monument-removed.jpg"
              alt="Image of a removed Nazarbayev monument"
            >

            <figcaption>
              <strong>
                <span class="photo-number">06</span>
