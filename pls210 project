    </section>


    <!-- ==================================================
         SLIDE 6 — UZBEKISTAN PHOTOS 10–11
    ================================================== -->

    <section class="slide" data-title="Uzbekistan: institutional naming">
      <div class="container">

        <div class="eyebrow">
          Case 02 · Uzbekistan
        </div>

        <h2>
          Commemoration through
          <span class="accent">institutional names</span>
        </h2>

        <div class="gallery two">

          <!-- PICTURE 10 -->

          <figure class="photo">
            <img
              src="images/10-karimov-airport-sign.jpg"
              alt="Tashkent International Airport sign bearing Islam Karimov's name"
            >

            <figcaption>
