      </div>
    </section>


    <!-- ==================================================
         SLIDE 4 — KAZAKHSTAN PHOTOS 4–6
    ================================================== -->

    <section class="slide" data-title="Kazakhstan: naming and change">
      <div class="container">

        <div class="eyebrow">
          Case 01 · Kazakhstan
        </div>

        <h2>
          Naming, institutions
          <span class="accent">&amp; change</span>
        </h2>

        <div class="gallery">

          <!-- PICTURE 4 -->

          <figure class="photo contain">
            <img
              src="images/04-nu-nis-foundation-logo.jpg"
