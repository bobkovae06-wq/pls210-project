
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#081426">

  <title>Remembering the First Presidents | PLS 210</title>

  <style>
    :root {
      --navy: #081426;
      --navy-2: #0c1c33;
      --navy-3: #122642;
      --card: #142945;
      --white: #f7faff;
      --muted: #b5c5da;
      --blue: #48a6ff;
      --blue-soft: #a9d8ff;
      --line: rgba(184, 209, 240, 0.18);
      --shadow: 0 18px 60px rgba(0, 0, 0, 0.23);
      --sans: Inter, "Segoe UI", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      height: 100%;
    }

    body {
      background: var(--navy);
      color: var(--white);
      font-family: var(--sans);
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--blue-soft);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    a:hover {
      color: var(--white);
    }

    button {
      font: inherit;
    }

    /* PRESENTATION */

    .deck {
      height: 100vh;
      height: 100svh;
      overflow-y: auto;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
    }

    .deck::-webkit-scrollbar {
      display: none;
    }

    .slide {
      min-height: 100vh;
      min-height: 100svh;
      scroll-snap-align: start;
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 72px 72px 80px;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 85% 15%,
          rgba(72, 166, 255, 0.10),
          transparent 38%
        ),
        linear-gradient(145deg, var(--navy), var(--navy-2));
    }

    .slide:nth-child(even) {
      background:
        radial-gradient(
          circle at 10% 80%,
          rgba(72, 166, 255, 0.10),
          transparent 38%
        ),
        var(--navy-2);
    }

    .slide::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(
        90deg,
        var(--blue),
        rgba(72, 166, 255, 0)
      );
    }

    .container {
      width: min(100%, 1120px);
      position: relative;
      z-index: 1;
    }

    .center {
      text-align: center;
    }

    .center .intro,
    .center .description {
      margin-left: auto;
      margin-right: auto;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
      color: var(--blue-soft);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: 0.19em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 24px;
      height: 2px;
      background: var(--blue);
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    h1 {
      max-width: 1000px;
      margin-bottom: 25px;
      font-size: clamp(38px, 5.7vw, 76px);
      line-height: 1.06;
      letter-spacing: -0.045em;
    }

    h2 {
      margin-bottom: 24px;
      font-size: clamp(29px, 4.1vw, 51px);
      line-height: 1.12;
      letter-spacing: -0.035em;
    }

    h3 {
      font-size: 19px;
      line-height: 1.3;
    }

    .accent {
      color: var(--blue);
    }

    .intro {
      max-width: 820px;
      color: var(--muted);
      font-size: clamp(18px, 2.1vw, 25px);
      line-height: 1.55;
    }

    .description {
      max-width: 920px;
      color: var(--muted);
      font-size: clamp(16px, 1.7vw, 21px);
      line-height: 1.6;
    }

    .small {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .label {
      display: inline-block;
      padding: 9px 14px;
      border: 1px solid rgba(72, 166, 255, 0.35);
      border-radius: 999px;
      background: rgba(72, 166, 255, 0.10);
      color: var(--blue-soft);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    /* LAYOUT */

    .split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 42px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }

    .cards.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .card {
      padding: 26px;
      background: rgba(20, 41, 69, 0.82);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }

    .card h3 {
      margin-bottom: 12px;
      color: var(--blue-soft);
    }

    .card p {
      margin-bottom: 0;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.55;
    }

    .source {
      margin-top: 14px;
      color: var(--blue);
      font-size: 12px;
      font-weight: 700;
      line-height: 1.5;
    }

    .statement {
      padding: 30px 35px;
      margin-top: 28px;
      border-left: 4px solid var(--blue);
      border-radius: 0 16px 16px 0;
      background: rgba(72, 166, 255, 0.08);
      color: var(--white);
      font-size: clamp(19px, 2.2vw, 27px);
      line-height: 1.5;
    }

    /* PHOTO GALLERY */

    .gallery {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 26px;
    }

    .gallery.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .photo {
      margin: 0;
      padding: 8px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .photo img {
      display: block;
      width: 100%;
      height: clamp(170px, 31vh, 300px);
      object-fit: cover;
      border-radius: 10px;
      background: #20344f;
    }

    .photo.contain img {
      object-fit: contain;
      padding: 10px;
    }

    .photo figcaption {
      padding: 12px 6px 5px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
    }

    .photo figcaption strong {
      display: block;
      margin-bottom: 4px;
      color: var(--white);
      font-size: 14px;
    }

    .photo-number {
      color: var(--blue);
      font-weight: 800;
      margin-right: 6px;
    }

    .gallery-note {
      margin-top: 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    /* RESEARCH QUESTION */

    .research-question {
      max-width: 1000px;
      margin: 25px auto;
      font-size: clamp(26px, 3.7vw, 48px);
      font-weight: 650;
      line-height: 1.35;
      letter-spacing: -0.025em;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 28px;
    }

    .chip {
      padding: 10px 15px;
      background: rgba(72, 166, 255, 0.10);
      border: 1px solid rgba(72, 166, 255, 0.28);
      border-radius: 999px;
      color: var(--blue-soft);
      font-size: 14px;
    }

    /* TIMELINE */

    .timeline {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }

    .event {
      position: relative;
      padding: 25px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
    }

    .event .year {
      display: block;
      margin-bottom: 12px;
      color: var(--blue);
      font-size: 31px;
      font-weight: 800;
    }

    .event p {
      margin: 0;
      color: var(--muted);
      line-height: 1.5;
    }

    /* CONCEPTS */

    .concepts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
      margin-top: 28px;
    }

    .concept {
      display: flex;
      gap: 16px;
      padding: 22px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 16px;
    }

    .concept-number {
      color: var(--blue);
      font-size: 25px;
      font-weight: 800;
    }

    .concept h3 {
      margin-bottom: 7px;
      color: var(--white);
    }

    .concept p {
      margin-bottom: 0;
      color: var(--muted);
      line-height: 1.5;
    }

    /* NUMBERED TEXT */

    .points {
      display: grid;
      gap: 18px;
      margin-top: 28px;
    }

    .point {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      padding: 20px 24px;
      background: rgba(20, 41, 69, 0.75);
      border: 1px solid var(--line);
      border-radius: 15px;
    }

    .point .number {
      flex-shrink: 0;
      color: var(--blue);
      font-size: 22px;
      font-weight: 800;
    }

    .point p {
      margin: 0;
      color: var(--white);
      font-size: clamp(16px, 1.8vw, 21px);
      line-height: 1.5;
    }

    /* REFERENCES */

    .references {
      display: grid;
      gap: 13px;
      margin-top: 25px;
    }

    .references p {
      margin: 0;
      padding-left: 24px;
      text-indent: -24px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    /* NAVIGATION */

    .navigation {
      position: fixed;
      z-index: 100;
      top: 50%;
      right: 17px;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .navigation button {
      width: 9px;
      height: 9px;
      padding: 0;
      border: 1px solid var(--blue);
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
    }

    .navigation button.active {
      background: var(--blue);
      box-shadow: 0 0 12px rgba(72, 166, 255, 0.65);
      transform: scale(1.35);
    }

    .slide-counter {
      position: fixed;
      z-index: 100;
      bottom: 22px;
      right: 25px;
      color: var(--muted);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.1em;
    }

    .slide-counter strong {
      color: var(--blue);
    }

    .keyboard-hint {
      position: fixed;
      z-index: 100;
      bottom: 22px;
      left: 25px;
      color: var(--muted);
      font-size: 12px;
    }

    /* RESPONSIVE DESIGN */

    @media (max-width: 850px) {
      .slide {
        padding: 65px 35px 75px;
        overflow-y: auto;
      }

      .split,
      .cards,
      .cards.three,
      .timeline {
        grid-template-columns: 1fr;
      }

      .gallery {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .gallery.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .photo img {
        height: 190px;
      }

      .concepts {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 20px;
      }

      .navigation {
        right: 7px;
      }
    }

    @media (max-width: 520px) {
      .slide {
        padding: 62px 25px 75px;
      }

      .gallery,
      .gallery.two {
        grid-template-columns: 1fr;
      }

      .photo img {
        height: 175px;
      }

      .eyebrow {
        font-size: 10px;
      }

      .statement {
        padding: 20px;
      }

      .point {
        padding: 15px;
      }

      .keyboard-hint {
        display: none;
      }

      .references p {
        font-size: 11px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .deck {
        scroll-behavior: auto;
      }
    }
  </style>
</head>

<body>

  <nav
    class="navigation"
    id="navigation"
    aria-label="Presentation navigation">
  </nav>

  <div class="slide-counter" id="counter">
